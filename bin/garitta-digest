        'h_ip': 'IP', 'h_wl': 'Whitelist', 'h_events': 'Eventi', 'h_last': 'Ultimo',
        'bans': 'Ban applicati: {n} IP', 'by_reason': 'IP per motivo', 'none': 'nessuno',
        'h_country': 'Paese', 'h_as': 'AS', 'h_reasons': 'Motivi', 'h_until': 'Scade',
        'more': '... altre {n} righe non mostrate.', 'status': 'Stato',
        'st_decisions': 'Decisioni attive per origine',
        'st_blocklist': 'Data-Shield: ultimo import {t}, {n} IP ({p}, verificata: {v})',
        'st_nc': 'Login Nextcloud falliti nel periodo: {n}',
        'footer': 'Generato da garitta-digest {v} su {h} il {t}.',
    },
}


def tr(key, **kw):
    return T.get(OPT['REPORT_LANG'], T['en'])[key].format(**kw)


def read(path):
    with open(path, errors='replace') as f:
        return f.read()


def load_conf(path=None):
    path = path or CONF
    if not os.path.exists(path):
        return
    for line in read(path).splitlines():
        m = re.match(r'^\s*([A-Z_]+)=(.*)$', line)
        if m and m.group(1) in OPT:
            v = m.group(2).split(' #')[0].strip()
            OPT[m.group(1)] = v[1:-1] if len(v) > 1 and v[0] == v[-1] and v[0] in '"\'' else v


def cscli(*args):
    r = subprocess.run([OPT['CSCLI'], *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                       universal_newlines=True, timeout=600)
    if r.returncode != 0:
        raise RuntimeError(f"cscli {' '.join(args)}: {r.stderr.strip()[:300]}")
    return r.stdout


def raw_rows(text):
    return list(csv.DictReader(io.StringIO(text)))


def ts(s):
    """ISO 8601 (with Z or nanoseconds too) -> aware datetime"""
    s = s.strip().replace('Z', '+00:00')
    s = re.sub(r'(\.\d{6})\d+', r'\1', s)
    d = datetime.fromisoformat(s)
    return d if d.tzinfo else d.replace(tzinfo=LOCAL)


def fmt(d, key='date'):
    return d.astimezone(LOCAL).strftime(tr(key))


def open_any(path):
    return gzip.open(path, 'rt', errors='replace') if path.endswith('.gz') else open(path, errors='replace')


def recent_files(pattern, start):
    """current file plus rotated ones modified after the start of the window"""
    return [f for f in sorted(glob.glob(pattern)) if os.path.getmtime(f) >= start.timestamp() - 3600]


# ---------- allowlists: Local API allowlists + local parser whitelists ----------
class Whitelist:
    def __init__(self):
        self.entries = []   # (network, source, comment)

    def add(self, value, source, comment=''):
        try:
            self.entries.append((ipaddress.ip_network(value.strip(), strict=False), source, comment))
        except ValueError:
            pass

    def match(self, ip):
        try:
            a = ipaddress.ip_address(ip)
        except ValueError:
            return None
        for net, src, com in self.entries:
            if a.version == net.version and a in net:
                return src, com
        return None


def parser_whitelists(base):
    """local (not hub managed) parser/postoverflow whitelists: {file: (reason, [values], has_expression)}"""
    out = {}
    for f in sorted(glob.glob(f'{base}/parsers/*/*.yaml') + glob.glob(f'{base}/postoverflows/*/*.yaml')):
        if os.path.islink(f):
            continue
        text = read(f)
        if not re.search(r'^whitelist:', text, re.M):
            continue
        reason, vals, key = '', [], None
        for line in text.splitlines():
            m = re.match(r'^\s*(\w+):\s*(.*)$', line)
            if m:
                key = m.group(1)
                if key == 'reason':
                    reason = m.group(2).strip().strip('"\'')
                continue
            m = re.match(r'^\s*-\s*["\']?([0-9A-Fa-f:.]+(?:/\d+)?)["\']?\s*$', line)
            if m and key in ('ip', 'cidr'):
                vals.append(m.group(1))
        out[f] = (reason, vals, bool(re.search(r'^\s*expression:', text, re.M)))
    return out


def lapi_allowlists(wl, with_comments=True):
    try:
        for al in raw_rows(cscli('allowlists', 'list', '-o', 'raw')):
            for it in raw_rows(cscli('allowlists', 'inspect', al['name'], '-o', 'raw')):
                exp = it.get('expiration', 'never')
                if exp not in ('never', '') and ts(exp) < NOW:
                    continue
                wl.add(it['value'], f"allowlist {al['name']}", it.get('comment', '') if with_comments else '')
    except Exception as e:  # CrowdSec < 1.6.8 has no centralized allowlists
        print(f'allowlists unavailable: {e}', file=sys.stderr)
    return wl


def load_whitelist():
    wl = lapi_allowlists(Whitelist())
    for f, (reason, vals, _) in parser_whitelists(OPT['CROWDSEC_DIR']).items():
        for v in vals:
            wl.add(v, f'whitelist {os.path.basename(f)}', reason)
    return wl


# ---------- collection ----------
def crowdsec_bans(start):
    secs = int((NOW - start).total_seconds()) + 60
    bans = []
    for origin in ('crowdsec', 'cscli'):
        alerts = json.loads(cscli('alerts', 'list', '--since', f'{secs}s', '--origin', origin,
                                  '--limit', '0', '-o', 'json') or 'null') or []
        for a in alerts:
            t = ts(a['created_at'])
            if t < start:
                continue
            src = a.get('source') or {}
            for d in a.get('decisions') or []:
                if d.get('origin') != origin:
                    continue
                bans.append(dict(time=t, ip=d['value'], what=d.get('scenario') or a.get('scenario', ''),
                                 origin='CrowdSec' if origin == 'crowdsec' else tr('manual'),
                                 until=a.get('stop_at') and ts(a['stop_at']),
                                 cn=src.get('cn', ''), asn=src.get('as_name', '')))
    return bans


OVF = re.compile(r'^time="([^"]+)".*msg="(?:Ip|Range) (\S+) performed \'([^\']+)\' \((\d+) events over ([^)]*)\)')


def crowdsec_overflows(start, wl):
    """scenario overflows from allowlisted IPs: bans that would have fired but were dropped"""
    hits = []
    for f in recent_files(f"{OPT['CROWDSEC_LOG_DIR']}/crowdsec*.log*", start):
        if 'crowdsec_api' in f or 'bouncer' in f:
            continue
        with open_any(f) as fh:
            for line in fh:
                if ' performed ' not in line:
                    continue
                m = OVF.match(line)
                if not m or ts(m.group(1)) < start or not wl.match(m.group(2)):
                    continue
                hits.append(dict(time=ts(m.group(1)), ip=m.group(2), kind=tr('k_avoided'),
                                 detail=tr('events', s=m.group(3), n=m.group(4), d=m.group(5))))
    return hits


F2B = re.compile(r'^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d),\d+ fail2ban\.\w+\s+\[\d+\]: \w+\s+\[([^\]]+)\] '
                 r'(Ban|Ignore) (\S+)(?: by (\S+))?')


def fail2ban_events(start):
    bans, ignores = [], []
    if not OPT['FAIL2BAN_LOG']:
        return bans, ignores
    for f in recent_files(OPT['FAIL2BAN_LOG'] + '*', start):
        with open_any(f) as fh:
            for line in fh:
                if '] Ban ' not in line and '] Ignore ' not in line:
                    continue
                m = F2B.match(line)
                if not m:
                    continue
                t = datetime.strptime(m.group(1), '%Y-%m-%d %H:%M:%S').replace(tzinfo=LOCAL)
                if t < start:
                    continue
                if m.group(3) == 'Ban':
                    bans.append(dict(time=t, ip=m.group(4), what=tr('jail', j=m.group(2)), origin='fail2ban',
                                     until=None, cn='', asn=''))
                else:
                    ignores.append(dict(time=t, ip=m.group(4), kind=tr('k_ignored'),
                                        detail=tr('ignoreip', j=m.group(2), b=m.group(5) or '')))
    return bans, ignores


NCFAIL = re.compile(r"Login failed: '?(.*?)'? \(Remote IP: '?([^')]+)'?\)")


def nextcloud_failed(start, wl):
    path = OPT['NEXTCLOUD_LOG']
    if path == 'auto':
        path = '/var/www/nextcloud/data/nextcloud.log'
    hits, total = [], 0
    if not path or not os.path.exists(path):
        return hits, None
    for f in recent_files(path + '*', start):
        with open_any(f) as fh:
            for line in fh:
                if 'Login failed' not in line:
                    continue
                try:
                    e = json.loads(line)
                    t = ts(e['time'])
                except (ValueError, KeyError):
                    continue
                m = NCFAIL.search(e.get('message', ''))
                if t < start or not m:
                    continue
                total += 1
                ip = e.get('remoteAddr') or m.group(2)
                if wl.match(ip):
                    hits.append(dict(time=t, ip=ip, kind=tr('k_nclogin'), detail=tr('user', u=m.group(1))))
    return hits, total


def decision_stats():
    try:
        rows = raw_rows(cscli('decisions', 'list', '-a', '--limit', '0', '-o', 'raw'))
    except Exception as e:
        return {'error': str(e)}
    return Counter(r.get('source', '?') for r in rows)


def blocklist_status():
    st = {}
    if os.path.exists(OPT['BLOCKLIST_STATUS']):
        for line in read(OPT['BLOCKLIST_STATUS']).splitlines():
            k, _, v = line.strip().partition('=')
            st[k] = v
    return st


# ---------- email ----------
def smtp_conf(path):
    """minimal reader for the CrowdSec email plugin YAML (flat keys + lists), no PyYAML needed"""
    def val(v):
        v = v.strip()
        if v and v[0] in '"\'':
            end = v.find(v[0], 1)
            return v[1:end] if end > 0 else v[1:]
        return re.split(r'\s+#', v)[0].strip()
    for doc in re.split(r'^---\s*$', read(path), flags=re.M):
        cfg, key = {}, None
        for line in doc.splitlines():
            if not line.strip() or line.lstrip().startswith('#'):
                continue
            m = re.match(r'^([A-Za-z_]+):\s*(.*)$', line)
            if m:
                key, v = m.group(1), val(m.group(2))
                cfg[key] = v if v else []
                continue
            m = re.match(r'^\s*-\s*(.+)$', line)
            if m and isinstance(cfg.get(key), list):
                cfg[key].append(val(m.group(1)))
        if cfg.get('type') == 'email':
            return cfg
    raise RuntimeError(f'no email configuration found in {path}')


def send(cfg, to, subject, text, htmlbody):
    msg = EmailMessage()
    msg['From'] = formataddr((cfg.get('sender_name') or 'CrowdSec', cfg['sender_email']))
    msg['To'] = ', '.join(to)
    msg['Subject'] = subject
    msg['Date'] = formatdate(localtime=True)
    msg['Message-ID'] = make_msgid(domain=cfg['sender_email'].split('@')[-1])
    msg.set_content(text)
    msg.add_alternative(htmlbody, subtype='html')
    host, port = cfg['smtp_host'], int(cfg.get('smtp_port') or 465)
    enc, helo = cfg.get('encryption_type', 'ssltls'), cfg.get('helo_host') or None
    ctx = ssl.create_default_context()
    if enc == 'ssltls':
        s = smtplib.SMTP_SSL(host, port, local_hostname=helo, timeout=60, context=ctx)
    else:
        s = smtplib.SMTP(host, port, local_hostname=helo, timeout=60)
        if enc == 'starttls':
            s.starttls(context=ctx)
    with s:
        if cfg.get('auth_type', 'login') != 'none' and cfg.get('smtp_username'):
            s.login(cfg['smtp_username'], cfg.get('smtp_password', ''))
        s.send_message(msg)


# ---------- report ----------
E = html.escape
TD = 'style="padding:4px 8px;border-bottom:1px solid #ddd;vertical-align:top"'
TH = 'style="padding:4px 8px;border-bottom:2px solid #999;text-align:left;background:#f3f3f3"'


def table(headers, rows):
    h = ''.join(f'<th {TH}>{E(x)}</th>' for x in headers)
    b = ''.join('<tr>' + ''.join(f'<td {TD}>{c}</td>' for c in r) + '</tr>' for r in rows)
    return f'<table style="border-collapse:collapse;font-size:13px;width:100%"><tr>{h}</tr>{b}</table>'


def cti(ip):
    return f'<a href="https://app.crowdsec.net/cti/{E(ip)}">{E(ip)}</a>'


def build(start, wl, bans, wl_events, nc_total, stats, bl, smtp):
    """returns (subject, text, html)"""
    maxrows = int(OPT['MAX_ROWS'])
    host = OPT['REPORT_NAME'] or socket.getfqdn()
    wl_events = list(wl_events)
    # an actual ban on an allowlisted IP is the most severe case
    wl_bans = [b for b in bans if wl.match(b['ip'])]
    for b in wl_bans:
        wl_events.append(dict(time=b['time'], ip=b['ip'], kind=tr('k_banned', o=b['origin']),
                              detail=b['what'], severe=True))
    per_ip = defaultdict(list)
    for ev in wl_events:
        per_ip[ev['ip']].append(ev)
    wl_rows, wl_text = [], []
    for ip, evs in sorted(per_ip.items(), key=lambda kv: (not any(e.get('severe') for e in kv[1]), -len(kv[1]))):
        src, com = wl.match(ip)
        grp = Counter((e['kind'], e['detail'], bool(e.get('severe'))) for e in evs)
        last = max(e['time'] for e in evs)
        lines = [(f'<b style="color:#d93025">{E(k)}</b> ' if sev else f'<b>{E(k)}</b> ') + E(d)
                 + (f' &times;{n}' if n > 1 else '') for (k, d, sev), n in grp.most_common()]
        wl_rows.append([f'<b>{E(ip)}</b>', E(f'{com} ({src})' if com else src), '<br>'.join(lines), fmt(last)])
        wl_text.append(f"  {ip}  [{com or src}]  {fmt(last)}\n" +
                       ''.join(f"      {k}: {d}" + (f" x{n}" if n > 1 else '') + '\n'
                               for (k, d, _), n in grp.most_common()))

    agg = {}   # one row per IP, CrowdSec and fail2ban reasons together
    for b in sorted((b for b in bans if not wl.match(b['ip'])), key=lambda b: b['time']):
        a = agg.setdefault(b['ip'], dict(ip=b['ip'], cn='', asn='', until=None, why=Counter()))
        a['time'] = b['time']
        a['why'][b['what'] if b['origin'] == 'CrowdSec' else f"{b['what']} ({b['origin']})"] += 1
        a['cn'], a['asn'] = a['cn'] or b['cn'], a['asn'] or b['asn']
        if b['until'] and (not a['until'] or b['until'] > a['until']):
            a['until'] = b['until']
    rows = sorted(agg.values(), key=lambda a: a['time'], reverse=True)
    by_reason = Counter(w for a in rows for w in a['why'])

    def why(a):
        return ', '.join(w + (f' x{n}' if n > 1 else '') for w, n in a['why'].most_common())

    n_wl, n_severe = len(per_ip), len({b['ip'] for b in wl_bans})
    base = OPT['SUBJECT'] or smtp.get('email_subject') or f'CrowdSec {host}'
    subject = (tr('subj_banned', n=n_severe) if n_severe else tr('subj_wl', n=n_wl) if n_wl else '') + \
        tr('subj', base=base, day=fmt(NOW, 'day'), n=len(agg))
    period = f'{fmt(start)} - {fmt(NOW)}'
    summary = ', '.join(f'{w}: {n}' for w, n in by_reason.most_common()) or tr('none')
    st = ', '.join(f'{k}: {v}' for k, v in sorted(stats.items(), key=lambda kv: -kv[1] if isinstance(kv[1], int) else 0))

    if n_wl:
        wl_html = ('<div style="border:2px solid #d93025;background:#fdecea;padding:10px;margin:12px 0">'
                   f'<h2 style="margin:0 0 6px;color:#d93025;font-size:17px">&#9888; {E(tr("wl_head", n=n_wl))}</h2>'
                   f'<p style="margin:0 0 8px;font-size:13px">{E(tr("wl_intro"))}'
                   + (f' <b style="color:#d93025">{E(tr("wl_banned"))}</b>' if n_severe else '') + '</p>'
                   + table([tr('h_ip'), tr('h_wl'), tr('h_events'), tr('h_last')], wl_rows) + '</div>')
    else:
        wl_html = ('<div style="border:2px solid #188038;background:#e6f4ea;padding:10px;margin:12px 0;font-size:14px">'
                   f'&#10004; {E(tr("wl_none"))}</div>')
    ban_rows = [[fmt(a['time']), cti(a['ip']), E(a['cn']), E(a['asn'][:40]), E(why(a)),
                 fmt(a['until']) if a['until'] else ''] for a in rows[:maxrows]]
    more = f'<p style="font-size:12px">{E(tr("more", n=len(rows) - maxrows))}</p>' if len(rows) > maxrows else ''
    status = [tr('st_decisions') + ': ' + st]
    if bl:
        status.append(tr('st_blocklist', t=bl.get('last_success', '?'), n=bl.get('imported', '?'),
                         p=bl.get('profile', ''), v=bl.get('verified', '?')))
    if nc_total is not None:
        status.append(tr('st_nc', n=nc_total))
    lang = 'it' if OPT['REPORT_LANG'] == 'it' else 'en'
    htmlbody = (f'<html lang="{lang}"><body style="font-family:Arial,Helvetica,sans-serif;color:#222;max-width:1000px">'
                f'<h1 style="font-size:19px;margin:0">{E(tr("title"))} &ndash; {E(host)}</h1>'
                f'<p style="margin:2px 0;color:#666;font-size:13px">{E(tr("period"))} {period}</p>{wl_html}'
                f'<h2 style="font-size:16px;margin:16px 0 4px">{E(tr("bans", n=len(agg)))}</h2>'
                f'<p style="font-size:13px;margin:0 0 6px">{E(tr("by_reason"))}: {E(summary)}</p>'
                + (table([tr('h_last'), tr('h_ip'), tr('h_country'), tr('h_as'), tr('h_reasons'), tr('h_until')],
                         ban_rows) if ban_rows else '') + more
                + f'<h2 style="font-size:16px;margin:16px 0 4px">{E(tr("status"))}</h2><ul style="font-size:13px;margin:0">'
                + ''.join(f'<li>{E(s)}</li>' for s in status) + '</ul>'
                f'<p style="font-size:11px;color:#888">{E(tr("footer", v=VERSION, h=host, t=fmt(NOW)))}</p></body></html>')
    text = (f"{tr('title')} - {host}\n{tr('period')} {period}\n\n"
            + (f"!!! {tr('wl_head', n=n_wl)}" + (f" - {tr('wl_banned')}" if n_severe else '') + "\n" + ''.join(wl_text)
               if n_wl else tr('wl_none') + '\n')
            + f"\n{tr('bans', n=len(agg))}\n{tr('by_reason')}: {summary}\n"
            + ''.join(f"  {fmt(a['time'])}  {a['ip']:<15}  {a['cn']:<2}  {why(a)}\n" for a in rows[:maxrows])
            + '\n' + '\n'.join(status) + '\n')
    return subject, text, htmlbody


def parse_since(s):
    m = re.fullmatch(r'(\d+)([hd])', s)
    if not m:
        raise SystemExit('--since: use e.g. 24h or 2d')
    return timedelta(hours=int(m.group(1)) * (24 if m.group(2) == 'd' else 1))


def check_parser_whitelists():
    """print local parser whitelists and whether the Local API allowlists fully cover them"""
    wl = lapi_allowlists(Whitelist(), with_comments=False)
    for f, (_, vals, expr) in parser_whitelists(OPT['CROWDSEC_DIR']).items():
        missing = [v for v in vals if not wl.match(v.split('/')[0])]
        state = 'expression' if expr else 'uncovered' if missing else 'covered'
        print(f"{state}\t{f}\t{len(vals)}" + (f"\t{' '.join(missing)}" if missing else ''))


def main(argv=None):
    ap = argparse.ArgumentParser(prog='garitta-digest', description=__doc__.splitlines()[0])
    ap.add_argument('--dry-run', action='store_true', help='do not send: print the text and save the HTML')
    ap.add_argument('--since', help='window (e.g. 24h, 2d); default = since the last report, at most 7 days')
    ap.add_argument('--to', help='recipients instead of the configured ones (comma separated)')
    ap.add_argument('--html', help='where to save the HTML in dry-run mode')
    ap.add_argument('--check-parser-whitelists', action='store_true',
                    help='list local parser whitelists and whether Local API allowlists cover them')
    ap.add_argument('--version', action='version', version=f'garitta-digest {VERSION}')
    args = ap.parse_args(argv)
    load_conf()
    if args.check_parser_whitelists:
        check_parser_whitelists()
        return

    os.makedirs(OPT['STATE_DIR'], exist_ok=True)
    stamp = os.path.join(OPT['STATE_DIR'], 'last_sent')
    if args.since:
        start = NOW - parse_since(args.since)
    else:
        try:
            start = max(ts(read(stamp)), NOW - timedelta(days=7))
        except (OSError, ValueError):
            start = NOW - timedelta(hours=24)

    smtp = smtp_conf(OPT['SMTP_CONF'])
    wl = load_whitelist()
    bans = crowdsec_bans(start)
    f2b_bans, f2b_ignored = fail2ban_events(start)
    nc_hits, nc_total = nextcloud_failed(start, wl)
    subject, text, htmlbody = build(start, wl, bans + f2b_bans,
                                    crowdsec_overflows(start, wl) + f2b_ignored + nc_hits,
                                    nc_total, decision_stats(), blocklist_status(), smtp)
    if args.dry_run:
        out = args.html or os.path.join(OPT['STATE_DIR'], 'preview.html')
        with open(out, 'w') as f:
            f.write(htmlbody)
        print(f'Subject: {subject}\n\n{text}\nHTML saved to {out}')
        return
    to = [x.strip() for x in (args.to or OPT['MAIL_TO']).split(',') if x.strip()] or smtp.get('receiver_emails') or []
    if not to:
        raise SystemExit('no recipients configured')
    send(smtp, to, subject, text, htmlbody)
    if not args.since:
        with open(stamp, 'w') as f:
            f.write(NOW.isoformat())
    print(f'sent to {", ".join(to)}: {subject}')


if __name__ == '__main__':
    main()
