        'k_banned': 'BANNED by {o}', 'k_avoided': 'CrowdSec: ban avoided', 'k_ignored': 'fail2ban: ignored',
        'k_nclogin': 'Nextcloud: failed login', 'user': 'user {u}',
        'events': '{s} ({n} events in {d})', 'jail': 'jail {j}', 'ignoreip': 'jail {j} (ignoreip {b})',
        'manual': 'manual (cscli)',
        'h_ip': 'IP', 'h_wl': 'Allowlist', 'h_events': 'Events', 'h_last': 'Last',
        'bans': 'Bans applied: {n} IPs', 'by_reason': 'IPs per reason', 'none': 'none',
        'h_country': 'Country', 'h_as': 'AS', 'h_reasons': 'Reasons', 'h_until': 'Expires',
        'more': '... {n} more rows not shown.', 'status': 'Status',
        'st_decisions': 'Active decisions per origin',
        'st_blocklist': 'Data-Shield: last import {t}, {n} IPs ({p}, verified: {v})',
        'st_nc': 'Failed Nextcloud logins in this period: {n}',
        'footer': 'Generated by garitta-digest {v} on {h} at {t}.',
    },
    'it': {
        'date': '%d/%m %H:%M', 'day': '%d/%m',
        'title': 'CrowdSec - report giornaliero', 'period': 'Periodo',
        'subj_banned': '[!! {n} IP whitelist BANNATI] ', 'subj_wl': '[! {n} IP whitelist] ',
        'subj': '{base} - report {day}: {n} IP bannati',
        'wl_head': 'IP in whitelist coinvolti: {n}',
        'wl_intro': 'IP fidati che hanno fatto scattare un controllo. Non vengono bloccati, ma spesso indicano '
                    'una password vecchia salvata su qualche dispositivo o un PC compromesso.',
        'wl_banned': 'Alcuni risultano BANNATI: verificare subito.',
        'wl_none': 'Nessun evento da IP in whitelist nel periodo.',
        'k_banned': 'BANNATO da {o}', 'k_avoided': 'CrowdSec: ban evitato', 'k_ignored': 'fail2ban: ignorato',
        'k_nclogin': 'Nextcloud: login fallito', 'user': 'utente {u}',
        'events': '{s} ({n} eventi in {d})', 'jail': 'jail {j}', 'ignoreip': 'jail {j} (ignoreip {b})',
