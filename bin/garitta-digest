#!/usr/bin/env python3
"""garitta-digest - daily email report of CrowdSec and fail2ban bans.

Replaces the per-ban real-time notifications with one email a day. Events that involve
allowlisted/whitelisted IPs are listed first: an allowlisted IP that is banned anyway, a ban
avoided thanks to the allowlist, an IP ignored by fail2ban, a failed Nextcloud login.

Config: /etc/default/garitta-digest. SMTP settings come from the CrowdSec email plugin.
"""
import argparse
import csv
import glob
import gzip
import html
import io
import ipaddress
import json
import os
import re
import smtplib
import socket
import ssl
import subprocess
import sys
from collections import Counter, defaultdict
from datetime import datetime, timedelta, timezone
from email.message import EmailMessage
from email.utils import formataddr, formatdate, make_msgid

VERSION = '0.1.0'
CONF = os.environ.get('GARITTA_DIGEST_CONF', '/etc/default/garitta-digest')
OPT = {
    'SMTP_CONF': '/etc/crowdsec/notifications/email.yaml',
    'MAIL_TO': '',              # comma separated; empty = receiver_emails from SMTP_CONF
    'SUBJECT': '',              # empty = email_subject from SMTP_CONF
    'REPORT_NAME': '',          # server name shown in the report; empty = FQDN
    'REPORT_LANG': 'en',        # en | it
    'CROWDSEC_DIR': '/etc/crowdsec',
    'CROWDSEC_LOG_DIR': '/var/log',
    'FAIL2BAN_LOG': '/var/log/fail2ban.log',  # empty = skip fail2ban
    'NEXTCLOUD_LOG': 'auto',    # auto = /var/www/nextcloud/data/nextcloud.log if present; empty = skip
    'MAX_ROWS': '300',
    'STATE_DIR': '/var/lib/garitta/digest',
    'BLOCKLIST_STATUS': '/var/lib/garitta/blocklist/status',
    'CSCLI': 'cscli',
}
NOW = datetime.now(timezone.utc)
LOCAL = NOW.astimezone().tzinfo

T = {
    'en': {
        'date': '%Y-%m-%d %H:%M', 'day': '%Y-%m-%d',
        'title': 'CrowdSec daily report', 'period': 'Period',
        'subj_banned': '[!! {n} allowlisted IPs BANNED] ', 'subj_wl': '[! {n} allowlisted IPs] ',
        'subj': '{base} - report {day}: {n} IPs banned',
        'wl_head': 'Allowlisted IPs involved: {n}',
