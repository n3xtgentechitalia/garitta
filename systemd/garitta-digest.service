[Unit]
Description=Garitta: daily email report of CrowdSec and fail2ban bans
After=crowdsec.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=@SBINDIR@/garitta-digest
TimeoutStartSec=15min
Nice=10
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=yes
